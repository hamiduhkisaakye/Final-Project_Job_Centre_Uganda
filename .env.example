# Copy to apps/api/.env and apps/web/.env.local (values already split below)

# ---- apps/api/.env ----
DATABASE_URL="postgresql://jobcentre:jobcentre_dev@localhost:5432/jobcentre?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Local-disk storage standing in for S3 (Phase 1). Swap for real S3 by
# implementing StorageProvider in apps/api/src/common/storage.ts.
LOCAL_STORAGE_DIR="./storage"
# Phase 2 semantic matching (pgvector). Leave blank to run without it — the
# app falls back to rule-based scoring only. Get a key at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# ---- apps/web/.env.local ----
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
